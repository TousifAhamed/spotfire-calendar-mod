{
    "name": "spotfire-calendar-mod",
    "version": "1.0.0",
    "description": "A Spotfire visualization mod that renders a D3-based calendar heatmap chart.",
    "private": true,
    "scripts": {
        "build": "npx @spotfire/mods-sdk build",
        "build:dev": "npx @spotfire/mods-sdk build --watch --debug",
        "server": "npx @spotfire/mods-dev-server",
        "start": "npx @spotfire/mods-sdk build --watch --debug"
    },
    "devDependencies": {
        "@spotfire/mods-api": "^1.3.0",
        "@spotfire/mods-dev-server": "^1.2.0",
        "@spotfire/mods-sdk": "^1.1.2",
        "@types/d3": "^7.4.3",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "d3": "^7.9.0"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    }
}
